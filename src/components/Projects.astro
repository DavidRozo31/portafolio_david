---
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<div class="grid gap-8 md:gap-10">
  {
    projects.map(({ name, summary, images, technologies, linkPreview, linkSource }) => (
      <div class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-white/10 to-white/5 border border-white/10 hover:border-primary/50 transition-all duration-300 hover:shadow-2xl hover:shadow-primary/20">
        <!-- Image Section -->
        <div class="relative h-64 md:h-72 overflow-hidden bg-gradient-to-br from-primary/20 to-primary/5">
          <div class="absolute inset-0 flex items-center justify-center">
            {images.length > 0 && (
              <Image
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                src={images[0]}
                alt={name}
                width="800"
                height="400"
              />
            )}
          </div>

          {/* Secondary images indicator */}
          {images.length > 1 && (
            <div class="absolute top-4 right-4 bg-black/60 backdrop-blur-sm px-3 py-1 rounded-full text-xs text-white font-medium">
              +{images.length - 1} imagen{images.length > 2 ? "s" : ""}
            </div>
          )}
        </div>

        <!-- Content Section -->
        <div class="p-8 md:p-10">
          <h3 class="mb-3 font-serif text-2xl md:text-3xl font-bold text-white group-hover:text-primary transition-colors">
            {name}
          </h3>

          <p class="mb-6 text-neutral leading-relaxed">
            {summary}
          </p>

          <!-- Technologies -->
          <div class="flex flex-wrap gap-2">
            {technologies.map((tech) => (
              <span class="inline-block rounded-full bg-primary/20 px-3 py-1 text-xs font-medium text-primary border border-primary/50 hover:bg-primary/30 transition-colors">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Decorative element -->
        <div class="absolute top-0 right-0 w-1 h-full bg-gradient-to-b from-primary via-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </div>
    ))
  }
</div>

