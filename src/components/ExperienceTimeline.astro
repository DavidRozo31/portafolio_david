---
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<div class="relative pl-12">
  <!-- Vertical line -->
  <div class="absolute left-3.5 top-2 bottom-0 w-0.5 bg-gradient-to-b from-primary to-primary/20"></div>

  {
    experience.map(({ company, position, startDate, endDate, summary }, index) => (
      <div class="relative mb-12">
        <!-- Timeline dot -->
        <div class="absolute -left-5 top-2 h-4 w-4 rounded-full border-3 border-black bg-primary"></div>

        <!-- Content -->
        <div>
          <h3 class="font-serif text-xl font-bold text-white">{position}</h3>
          <p class="text-sm text-primary font-medium mb-1">{company}</p>
          <p class="text-xs text-neutral mb-4">
            {startDate} — {endDate}
          </p>

          {Array.isArray(summary) ? (
            <ul class="space-y-2">
              {summary.map((item) => (
                <li class="flex gap-3 text-sm text-neutral">
                  <span class="text-primary mt-1">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-neutral">{summary}</p>
          )}
        </div>
      </div>
    ))
  }
</div>
