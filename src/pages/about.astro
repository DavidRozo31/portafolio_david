---
import { SITE_CONTENT, SITE_CONFIG } from "@config";
import Layout from "@layouts/Layout.astro";
import ExperienceTimeline from "@components/ExperienceTimeline.astro";

import "../styles/global.css";
---

<Layout>
  <section class="py-16 md:py-24" id="about">
    <!-- Header with Photo -->
    <div class="mb-16 text-center">
      <div class="mb-6 flex justify-center">
        <img
          src={SITE_CONFIG.siteLogo}
          alt={SITE_CONTENT.hero.name}
          class="h-32 w-32 rounded-full object-cover shadow-lg"
        />
      </div>
      <h1 class="mb-2 font-serif text-5xl md:text-6xl font-bold text-white">
        {SITE_CONTENT.hero.name}
      </h1>
      <p class="mb-4 text-lg text-primary font-medium">{SITE_CONTENT.hero.specialty}</p>
      <div class="flex justify-center gap-6 text-neutral">
        {
          SITE_CONFIG.socialLinks.map((link: { text: string; href: string }) => (
            <a href={link.href} target="_blank" class="hover:text-primary transition-colors">
              {link.text}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Two Column Layout -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
      <!-- Left Column -->
      <div class="md:col-span-2 space-y-12">
        <!-- Sobre mí -->
        <div>
          <h2 class="mb-6 font-serif text-3xl font-bold text-white">Sobre mí</h2>
          <p class="text-neutral leading-relaxed whitespace-pre-line">
            {SITE_CONTENT.about.description}
          </p>
        </div>

        <!-- Experiencia -->
        <div>
          <h2 class="mb-6 font-serif text-3xl font-bold text-white">Experiencia</h2>
          <ExperienceTimeline experience={SITE_CONTENT.experience} />
        </div>
      </div>

      <!-- Right Column -->
      <div class="space-y-12">
        <!-- Stack Tecnológico -->
        <div>
          <h3 class="mb-4 font-serif text-xl font-bold text-white">Stack Tecnológico</h3>
          <div class="flex flex-wrap gap-3">
            {
              SITE_CONTENT.skills.map((skill: string) => (
                <span class="inline-block rounded-full bg-primary px-4 py-2 text-sm font-medium text-white">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Educación -->
        <div>
          <h3 class="mb-4 font-serif text-xl font-bold text-white">Educación</h3>
          <div class="space-y-4">
            {
              SITE_CONTENT.education.map((edu: any) => (
                <div class="pb-4 border-b border-neutral/20 last:border-b-0">
                  <p class="font-medium text-white">{edu.degree}</p>
                  <p class="text-sm text-primary font-medium">{edu.school}</p>
                  <p class="text-xs text-neutral">{edu.year}</p>
                  <p class="text-xs text-neutral">{edu.location}</p>
                  {edu.gpa && <p class="text-xs text-primary mt-1">GPA: {edu.gpa}</p>}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Idiomas -->
        <div>
          <h3 class="mb-4 font-serif text-xl font-bold text-white">Idiomas</h3>
          <div class="space-y-3">
            {
              SITE_CONTENT.languages.map((lang: any) => (
                <div>
                  <div class="flex justify-between mb-2">
                    <p class="text-sm font-medium text-white">{lang.name}</p>
                    <p class="text-xs text-neutral">{lang.level}</p>
                  </div>
                  <div class="h-2 bg-neutral/20 rounded-full overflow-hidden">
                    <div
                      class="h-full bg-primary rounded-full transition-all duration-300"
                      style={{
                        width:
                          lang.level === "Nativo"
                            ? "100%"
                            : lang.level === "B2"
                              ? "80%"
                              : lang.level === "B1"
                                ? "70%"
                                : lang.level === "A2"
                                  ? "50%"
                                  : "30%",
                      }}
                    ></div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
