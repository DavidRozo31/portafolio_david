---
import { SITE_CONFIG, SITE_CONTENT } from "@config";
import Layout from "@layouts/Layout.astro";

import "../styles/global.css";
---

<Layout>
  <section class="py-24 md:py-32" id="contact">
    <!-- Header -->
    <div class="mb-16 text-center">
      <h1 class="mb-6 font-serif text-6xl md:text-7xl font-bold text-primary">
        Conectemos
      </h1>
      <p class="text-lg text-neutral max-w-2xl mx-auto">
        Siempre estoy abierto a discutir proyectos, ideas u oportunidades.
      </p>
    </div>

    <!-- Contact Options -->
    <div class="max-w-xl mx-auto space-y-4 mb-12">
      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/david-andres-rodr%C3%ADguez-rozo-7932ab2b0/"
        target="_blank"
        class="group block p-8 rounded-lg border-2 border-neutral/30 hover:border-primary/50 hover:bg-white/5 transition-all duration-300"
      >
        <div class="flex flex-col items-center text-center">
          <div class="text-4xl mb-3 group-hover:scale-110 transition-transform">🔗</div>
          <h3 class="font-serif text-xl font-bold text-white">LinkedIn</h3>
          <p class="text-sm text-primary mt-1">@David Rodríguez</p>
        </div>
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/DavidRozo31"
        target="_blank"
        class="group block p-8 rounded-lg border-2 border-neutral/30 hover:border-primary/50 hover:bg-white/5 transition-all duration-300"
      >
        <div class="flex flex-col items-center text-center">
          <div class="text-4xl mb-3 group-hover:scale-110 transition-transform">🐙</div>
          <h3 class="font-serif text-xl font-bold text-white">Github</h3>
          <p class="text-sm text-primary mt-1">@DavidRozo31</p>
        </div>
      </a>

      <!-- Email -->
      <div class="p-8 rounded-lg border-2 border-neutral/30 bg-white/5">
        <div class="flex flex-col items-center text-center">
          <div class="text-4xl mb-3">✉️</div>
          <h3 class="font-serif text-xl font-bold text-white">Email</h3>
          <p class="text-sm text-primary mt-1">@drozo1234</p>
        </div>
      </div>
    </div>

    <!-- Main Email Button -->
    <div class="flex justify-center mb-12">
      <a
        href={`mailto:${SITE_CONTENT.hero.email}`}
        class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-sky-600 transition-all duration-200 px-6 py-3 text-sm font-medium text-white shadow-lg hover:shadow-xl transform hover:scale-105"
      >
        <span>📧</span>
        <span>{SITE_CONTENT.hero.email}</span>
      </a>
    </div>

    <!-- Footer Message -->
    <div class="text-center">
      <p class="text-neutral max-w-lg mx-auto text-sm leading-relaxed">
        Puedes contactarme a través de cualquiera de estos canales o enviarme un email directamente. Respondo lo antes posible.
      </p>
    </div>
  </section>
</Layout>
